{
  "tool_name": "cause_ranking_service",
  "tool_kind": "global_tool_service",
  "description": "按车辆与一个已选 DTC 组一次召回维修知识，将数据库候选原因交给生产概率服务排序；远端不可用时自动使用本地概率方法降级。",
  "input_schema": {
    "examples": [
      {
        "brand": "丰田",
        "dtc_codes": [
          "P0136",
          "P0137",
          "P0138"
        ],
        "language": "en",
        "model": "汉兰达",
        "year": 2021
      },
      {
        "brand": "Ford",
        "dtc_codes": [
          "P0345",
          "P0349"
        ],
        "language": "en",
        "model": "FOCUS (C519E)",
        "year": 2023
      },
      {
        "brand": "Audi",
        "dtc_codes": [
          "U1121"
        ],
        "language": "en",
        "model": "A5L",
        "year": 2025
      },
      {
        "brand": "Audi",
        "dtc_codes": [
          "B1076"
        ],
        "language": "en",
        "model": "A5L",
        "year": 2025
      },
      {
        "brand": "Audi",
        "dtc_codes": [
          "P0667"
        ],
        "language": "en",
        "model": "A5L",
        "year": 2025
      },
      {
        "brand": "BMW",
        "dtc_codes": [
          "023080"
        ],
        "language": "en",
        "model": "X1 sDrive25Li",
        "year": 2024
      },
      {
        "brand": "BMW",
        "dtc_codes": [
          "D767DC"
        ],
        "language": "en",
        "model": "X1 sDrive25Li",
        "year": 2024
      },
      {
        "brand": "Mercedes-Benz",
        "dtc_codes": [
          "P1193"
        ],
        "language": "en",
        "model": "GLS 450 4MATIC",
        "year": 2018
      },
      {
        "brand": "Mercedes-Benz",
        "dtc_codes": [
          "P1190"
        ],
        "language": "en",
        "model": "GLS 450 4MATIC",
        "year": 2018
      }
    ],
    "properties": {
      "brand": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Brand",
        "type": "string"
      },
      "model": {
        "default": "",
        "maxLength": 128,
        "title": "Model",
        "type": "string"
      },
      "year": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Year"
      },
      "dtc_codes": {
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "minItems": 1,
        "title": "Dtc Codes",
        "type": "array"
      },
      "language": {
        "default": "en",
        "description": "Preferred display language as a BCP-47-style tag. Source knowledge is returned unchanged when no reviewed translation exists.",
        "maxLength": 35,
        "minLength": 2,
        "title": "Language",
        "type": "string"
      }
    },
    "required": [
      "brand",
      "dtc_codes"
    ],
    "title": "CauseRankingV1Input",
    "type": "object",
    "additionalProperties": false,
    "x-extract": {
      "brand": [
        "brand",
        "vehicle_info.brand",
        "messages[].content[].text.vehicle_info.brand"
      ],
      "model": [
        "vehicle_info.model",
        "messages[].content[].text.vehicle_info.model",
        "model"
      ],
      "year": [
        "year",
        "vehicle_info.year",
        "messages[].content[].text.vehicle_info.year"
      ],
      "dtc_codes": [
        "dtc_codes",
        "messages[].content[].dtc_codes",
        "system_dtc_groups[].dtc_codes[].dtc_code",
        "messages[].content[].text.system_dtc_groups[].dtc_codes[].dtc_code"
      ],
      "language": [
        "language"
      ]
    }
  },
  "output_schema": {
    "$defs": {
      "CausePredictionOut": {
        "additionalProperties": false,
        "properties": {
          "rank": {
            "minimum": 1,
            "title": "Rank",
            "type": "integer"
          },
          "candidate_key": {
            "description": "Request-local deterministic key; not a persistent business identifier.",
            "title": "Candidate Key",
            "type": "string"
          },
          "reason_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "title": "Reason Id"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "reason_language": {
            "default": "und",
            "title": "Reason Language",
            "type": "string"
          },
          "probability_percent": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Probability Percent",
            "type": "number"
          },
          "is_external": {
            "title": "Is External",
            "type": "boolean"
          },
          "prediction_source": {
            "title": "Prediction Source",
            "type": "string"
          },
          "probability_source": {
            "title": "Probability Source",
            "type": "string"
          },
          "supported_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Supported Dtcs",
            "type": "array"
          },
          "troubleshooting": {
            "description": "该候选原因对应的排查/检修指引文本；未知时省略",
            "title": "Troubleshooting",
            "type": "string"
          }
        },
        "required": [
          "rank",
          "reason",
          "probability_percent",
          "supported_dtcs"
        ],
        "title": "CausePredictionOut",
        "type": "object"
      },
      "MvpGroupOut": {
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "group_name": {
            "title": "Group Name",
            "type": "string"
          },
          "representative_dtc": {
            "title": "Representative Dtc",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          },
          "dtc_category": {
            "enum": [
              "动力系统",
              "底盘系统",
              "车身系统",
              "网络通讯系统"
            ],
            "title": "Dtc Category",
            "type": "string"
          },
          "dtc_category_code": {
            "enum": [
              "P",
              "C",
              "B",
              "U"
            ],
            "title": "Dtc Category Code",
            "type": "string"
          },
          "semantic_family_code": {
            "title": "Semantic Family Code",
            "type": "string"
          },
          "system": {
            "default": "",
            "title": "System",
            "type": "string"
          },
          "involved_parts": {
            "items": {
              "type": "string"
            },
            "title": "Involved Parts",
            "type": "array"
          },
          "shared_parts": {
            "items": {
              "type": "string"
            },
            "title": "Shared Parts",
            "type": "array"
          },
          "group_reason": {
            "enum": [
              "same_code",
              "same_system_shared_parts",
              "shared_parts",
              "semantic_family",
              "standalone"
            ],
            "title": "Group Reason",
            "type": "string"
          },
          "grouping_basis": {
            "items": {
              "type": "string"
            },
            "title": "Grouping Basis",
            "type": "array"
          },
          "match_level": {
            "enum": [
              "exact",
              "year_fallback"
            ],
            "title": "Match Level",
            "type": "string"
          },
          "year_fallback_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Year Fallback Dtcs",
            "type": "array"
          },
          "member_count": {
            "description": "Number of unique DTC codes",
            "minimum": 1,
            "title": "Member Count",
            "type": "integer"
          },
          "record_count": {
            "minimum": 1,
            "title": "Record Count",
            "type": "integer"
          },
          "priority": {
            "description": "Reserved until the product rule for group priority is confirmed.",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Priority",
            "type": "string"
          }
        },
        "required": [
          "group_id",
          "group_name",
          "representative_dtc",
          "dtc_codes",
          "involved_parts",
          "shared_parts",
          "group_reason",
          "grouping_basis",
          "match_level",
          "year_fallback_dtcs",
          "member_count",
          "record_count"
        ],
        "title": "MvpGroupOut",
        "type": "object"
      },
      "MvpIssue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unmatched_dtcs",
              "multiple_groups_detected",
              "no_candidate_causes",
              "no_static_checks",
              "no_repair_guides",
              "probability_provider_failed",
              "external_reasons_truncated",
              "recall_truncated"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MvpIssue",
        "type": "object"
      },
      "RecallMetaOut": {
        "additionalProperties": false,
        "properties": {
          "brand": {
            "title": "Brand",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "year": {
            "title": "Year",
            "type": "integer"
          },
          "requested_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Requested Dtcs",
            "type": "array"
          },
          "unmatched_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Unmatched Dtcs",
            "type": "array"
          },
          "uncertain_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Uncertain Dtcs",
            "type": "array"
          },
          "year_fallback_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Year Fallback Dtcs",
            "type": "array"
          },
          "query_truncated": {
            "title": "Query Truncated",
            "type": "boolean"
          },
          "recalled_record_count": {
            "minimum": 0,
            "title": "Recalled Record Count",
            "type": "integer"
          },
          "requested_language": {
            "title": "Requested Language",
            "type": "string"
          },
          "source_content_languages": {
            "items": {
              "type": "string"
            },
            "title": "Source Content Languages",
            "type": "array"
          },
          "language_fallback": {
            "title": "Language Fallback",
            "type": "boolean"
          },
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "grouping_policy_version": {
            "title": "Grouping Policy Version",
            "type": "string"
          }
        },
        "required": [
          "brand",
          "model",
          "requested_dtcs",
          "unmatched_dtcs",
          "uncertain_dtcs",
          "year_fallback_dtcs",
          "query_truncated",
          "recalled_record_count",
          "requested_language",
          "source_content_languages",
          "language_fallback",
          "core_version",
          "grouping_policy_version"
        ],
        "title": "RecallMetaOut",
        "type": "object"
      }
    },
    "properties": {
      "status": {
        "default": "ok",
        "enum": [
          "ok",
          "no_data",
          "partial",
          "missing_input"
        ],
        "title": "Status",
        "type": "string"
      },
      "message": {
        "default": "",
        "title": "Message",
        "type": "string"
      },
      "uncertainty_note": {
        "default": "",
        "title": "Uncertainty Note",
        "type": "string"
      },
      "missing_required_info": {
        "items": {
          "type": "string"
        },
        "title": "Missing Required Info",
        "type": "array"
      },
      "group": {
        "$ref": "#/$defs/MvpGroupOut",
        "title": "Group"
      },
      "predictions": {
        "items": {
          "$ref": "#/$defs/CausePredictionOut"
        },
        "title": "Predictions",
        "type": "array"
      },
      "local_candidate_count": {
        "minimum": 0,
        "title": "Local Candidate Count",
        "type": "integer"
      },
      "probability_source": {
        "enum": [
          "remote_hybrid",
          "local_assessor",
          "even_shares",
          "not_available"
        ],
        "title": "Probability Source",
        "type": "string"
      },
      "probability_degraded": {
        "title": "Probability Degraded",
        "type": "boolean"
      },
      "issues": {
        "items": {
          "$ref": "#/$defs/MvpIssue"
        },
        "title": "Issues",
        "type": "array"
      },
      "meta": {
        "$ref": "#/$defs/RecallMetaOut",
        "title": "Meta"
      }
    },
    "required": [
      "predictions",
      "local_candidate_count",
      "probability_source",
      "probability_degraded",
      "issues",
      "status",
      "message",
      "uncertainty_note",
      "missing_required_info"
    ],
    "title": "CauseRankingV1Output",
    "type": "object"
  }
}

{
  "tool_name": "dtc_grouping_service",
  "tool_kind": "global_tool_service",
  "description": "先按 PCBU 一级分类，再按规范化故障零部件交集聚合分组的全局服务，输出 DTC Group 或 independent DTC。",
  "input_schema": {
    "$defs": {
      "DtcEntry": {
        "properties": {
          "record_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "可选知识记录 ID",
            "title": "Record Id"
          },
          "dtc_code": {
            "minLength": 1,
            "title": "Dtc Code",
            "type": "string"
          },
          "dtc_category": {
            "anyOf": [
              {
                "enum": [
                  "动力系统",
                  "底盘系统",
                  "车身系统",
                  "网络通讯系统"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "省略时由 dtc_code 的 PCBU 首字母自动派生",
            "title": "Dtc Category"
          },
          "system": {
            "description": "一级分类下的二级系统名",
            "minLength": 1,
            "title": "System",
            "type": "string"
          },
          "related_parts": {
            "items": {
              "type": "string"
            },
            "title": "Related Parts",
            "type": "array"
          }
        },
        "required": [
          "dtc_code",
          "system",
          "related_parts"
        ],
        "title": "DtcEntry",
        "type": "object"
      },
      "VehicleContext": {
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Engine"
          },
          "vin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vin"
          },
          "configuration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Configuration"
          }
        },
        "title": "VehicleContext",
        "type": "object"
      }
    },
    "properties": {
      "dtc_list": {
        "description": "待分组的 DTC 列表；至少需要两个不同 DTC，单个 DTC 请使用 dtc_context_service。",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "title": "Dtc List",
        "type": "array"
      },
      "brand": {
        "minLength": 1,
        "title": "Brand",
        "type": "string"
      },
      "dtc_entries": {
        "items": {
          "$ref": "#/$defs/DtcEntry"
        },
        "title": "Dtc Entries",
        "type": "array"
      },
      "vehicle_info": {
        "anyOf": [
          {
            "$ref": "#/$defs/VehicleContext"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "dtc_list",
      "brand",
      "dtc_entries"
    ],
    "title": "DtcGroupingToolInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "DtcGroupData": {
        "properties": {
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "group_name": {
            "deprecated": true,
            "description": "中台兼容组名；新调用方优先使用 group_names",
            "title": "Group Name",
            "type": "string"
          },
          "representative_dtc": {
            "title": "Representative Dtc",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          },
          "dtcs": {
            "deprecated": true,
            "description": "中台兼容 DTC 列表；新调用方优先使用 dtc_codes",
            "items": {
              "type": "string"
            },
            "title": "Dtcs",
            "type": "array"
          },
          "record_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Record Ids",
            "type": "array"
          },
          "group_names": {
            "description": "组名来源：组内各逻辑 DTC 共享的规范化零部件",
            "items": {
              "type": "string"
            },
            "title": "Group Names",
            "type": "array"
          },
          "dtc_category": {
            "anyOf": [
              {
                "enum": [
                  "动力系统",
                  "底盘系统",
                  "车身系统",
                  "网络通讯系统"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dtc Category"
          },
          "system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "共同二级系统名；跨系统聚类时为 null",
            "title": "System"
          },
          "group_reason": {
            "enum": [
              "same_code",
              "same_system_shared_parts",
              "shared_parts",
              "standalone"
            ],
            "title": "Group Reason",
            "type": "string"
          },
          "member_count": {
            "title": "Member Count",
            "type": "integer"
          },
          "related_parts": {
            "items": {
              "type": "string"
            },
            "title": "Related Parts",
            "type": "array"
          },
          "grouping_basis": {
            "items": {
              "type": "string"
            },
            "title": "Grouping Basis",
            "type": "array"
          },
          "grouping_confidence": {
            "enum": [
              "high",
              "medium"
            ],
            "title": "Grouping Confidence",
            "type": "string"
          }
        },
        "required": [
          "group_id",
          "group_name",
          "representative_dtc",
          "dtc_codes",
          "dtcs",
          "record_ids",
          "group_names",
          "dtc_category",
          "group_reason",
          "member_count",
          "related_parts",
          "grouping_basis",
          "grouping_confidence"
        ],
        "title": "DtcGroupData",
        "type": "object"
      }
    },
    "properties": {
      "dtc_groups": {
        "items": {
          "$ref": "#/$defs/DtcGroupData"
        },
        "title": "Dtc Groups",
        "type": "array"
      },
      "independent_dtcs": {
        "items": {
          "type": "string"
        },
        "title": "Independent Dtcs",
        "type": "array"
      },
      "grouping_result": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Grouping Result"
      },
      "uncertainty_note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Uncertainty Note"
      },
      "missing_required_info": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Missing Required Info"
      }
    },
    "required": [
      "dtc_groups",
      "independent_dtcs"
    ],
    "title": "DtcGroupingToolOutput",
    "type": "object"
  }
}

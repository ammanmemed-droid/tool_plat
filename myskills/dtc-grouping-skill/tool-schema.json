{
  "tool_name": "dtc_grouping_service",
  "tool_kind": "global_tool_service",
  "description": "按车辆与一个或多个 DTC 一次召回维修知识，按稳定规则返回故障组、分组依据与未成组 DTC。",
  "input_schema": {
    "examples": [
      {
        "brand": "丰田",
        "dtc_codes": [
          "P0136",
          "P0137",
          "P0138",
          "P0420"
        ],
        "language": "en",
        "model": "汉兰达",
        "year": 2021
      },
      {
        "brand": "Audi",
        "dtc_codes": [
          "U05AC00",
          "P066700",
          "B1B5AF1",
          "U148500",
          "B16D649",
          "B10764A",
          "U112100",
          "U146700",
          "U159C00",
          "U019900",
          "U198C00",
          "U111100",
          "U043300"
        ],
        "language": "en",
        "model": "A5L",
        "year": 2025
      },
      {
        "brand": "BMW",
        "dtc_codes": [
          "023080",
          "030846",
          "D767DC",
          "7E0280"
        ],
        "language": "en",
        "model": "X1 sDrive25Li",
        "year": 2024
      },
      {
        "brand": "Ford",
        "dtc_codes": [
          "P0345:00:64",
          "P0349:00:64"
        ],
        "language": "en",
        "model": "FOCUS (C519E)",
        "year": 2023
      },
      {
        "brand": "Mercedes-Benz",
        "dtc_codes": [
          "P119300",
          "P119000"
        ],
        "language": "en",
        "model": "GLS 450 4MATIC",
        "year": 2018
      }
    ],
    "properties": {
      "brand": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Brand",
        "type": "string"
      },
      "model": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Model",
        "type": "string"
      },
      "year": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Year"
      },
      "dtc_codes": {
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "minItems": 1,
        "title": "Dtc Codes",
        "type": "array"
      },
      "language": {
        "default": "en",
        "description": "Preferred display language as a BCP-47-style tag. Source knowledge is returned unchanged when no reviewed translation exists.",
        "maxLength": 35,
        "minLength": 2,
        "title": "Language",
        "type": "string"
      }
    },
    "required": [
      "brand",
      "model",
      "dtc_codes"
    ],
    "title": "DtcGroupingV1Input",
    "type": "object",
    "additionalProperties": false,
    "x-extract": {
      "brand": [
        "brand",
        "vehicle_info.brand",
        "messages[].content[].text.vehicle_info.brand"
      ],
      "model": [
        "vehicle_info.model",
        "messages[].content[].text.vehicle_info.model",
        "model"
      ],
      "year": [
        "year",
        "vehicle_info.year",
        "messages[].content[].text.vehicle_info.year"
      ],
      "dtc_codes": [
        "dtc_codes",
        "messages[].content[].dtc_codes",
        "system_dtc_groups[].dtc_codes[].dtc_code",
        "messages[].content[].text.system_dtc_groups[].dtc_codes[].dtc_code"
      ],
      "language": [
        "language"
      ]
    }
  },
  "output_schema": {
    "$defs": {
      "MvpGroupOut": {
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "group_name": {
            "title": "Group Name",
            "type": "string"
          },
          "representative_dtc": {
            "title": "Representative Dtc",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          },
          "dtc_category": {
            "enum": [
              "动力系统",
              "底盘系统",
              "车身系统",
              "网络通讯系统"
            ],
            "title": "Dtc Category",
            "type": "string"
          },
          "dtc_category_code": {
            "enum": [
              "P",
              "C",
              "B",
              "U"
            ],
            "title": "Dtc Category Code",
            "type": "string"
          },
          "semantic_family_code": {
            "title": "Semantic Family Code",
            "type": "string"
          },
          "system": {
            "default": "",
            "title": "System",
            "type": "string"
          },
          "involved_parts": {
            "items": {
              "type": "string"
            },
            "title": "Involved Parts",
            "type": "array"
          },
          "shared_parts": {
            "items": {
              "type": "string"
            },
            "title": "Shared Parts",
            "type": "array"
          },
          "group_reason": {
            "enum": [
              "same_code",
              "same_system_shared_parts",
              "shared_parts",
              "semantic_family",
              "standalone"
            ],
            "title": "Group Reason",
            "type": "string"
          },
          "grouping_basis": {
            "items": {
              "type": "string"
            },
            "title": "Grouping Basis",
            "type": "array"
          },
          "match_level": {
            "enum": [
              "exact",
              "year_fallback"
            ],
            "title": "Match Level",
            "type": "string"
          },
          "year_fallback_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Year Fallback Dtcs",
            "type": "array"
          },
          "member_count": {
            "description": "Number of unique DTC codes",
            "minimum": 1,
            "title": "Member Count",
            "type": "integer"
          },
          "record_count": {
            "minimum": 1,
            "title": "Record Count",
            "type": "integer"
          },
          "priority": {
            "description": "Reserved until the product rule for group priority is confirmed.",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Priority",
            "type": "string"
          }
        },
        "required": [
          "group_id",
          "group_name",
          "representative_dtc",
          "dtc_codes",
          "involved_parts",
          "shared_parts",
          "group_reason",
          "grouping_basis",
          "match_level",
          "year_fallback_dtcs",
          "member_count",
          "record_count"
        ],
        "title": "MvpGroupOut",
        "type": "object"
      },
      "MvpIssue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unmatched_dtcs",
              "multiple_groups_detected",
              "no_candidate_causes",
              "no_static_checks",
              "no_repair_guides",
              "probability_provider_failed",
              "external_reasons_truncated",
              "recall_truncated"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MvpIssue",
        "type": "object"
      },
      "RecallMetaOut": {
        "additionalProperties": false,
        "properties": {
          "brand": {
            "title": "Brand",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "year": {
            "title": "Year",
            "type": "integer"
          },
          "requested_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Requested Dtcs",
            "type": "array"
          },
          "unmatched_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Unmatched Dtcs",
            "type": "array"
          },
          "uncertain_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Uncertain Dtcs",
            "type": "array"
          },
          "year_fallback_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Year Fallback Dtcs",
            "type": "array"
          },
          "query_truncated": {
            "title": "Query Truncated",
            "type": "boolean"
          },
          "recalled_record_count": {
            "minimum": 0,
            "title": "Recalled Record Count",
            "type": "integer"
          },
          "requested_language": {
            "title": "Requested Language",
            "type": "string"
          },
          "source_content_languages": {
            "items": {
              "type": "string"
            },
            "title": "Source Content Languages",
            "type": "array"
          },
          "language_fallback": {
            "title": "Language Fallback",
            "type": "boolean"
          },
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "grouping_policy_version": {
            "title": "Grouping Policy Version",
            "type": "string"
          }
        },
        "required": [
          "brand",
          "model",
          "requested_dtcs",
          "unmatched_dtcs",
          "uncertain_dtcs",
          "year_fallback_dtcs",
          "query_truncated",
          "recalled_record_count",
          "requested_language",
          "source_content_languages",
          "language_fallback",
          "core_version",
          "grouping_policy_version"
        ],
        "title": "RecallMetaOut",
        "type": "object"
      }
    },
    "properties": {
      "status": {
        "default": "ok",
        "enum": [
          "ok",
          "no_data",
          "partial",
          "missing_input"
        ],
        "title": "Status",
        "type": "string"
      },
      "message": {
        "default": "",
        "title": "Message",
        "type": "string"
      },
      "uncertainty_note": {
        "default": "",
        "title": "Uncertainty Note",
        "type": "string"
      },
      "missing_required_info": {
        "items": {
          "type": "string"
        },
        "title": "Missing Required Info",
        "type": "array"
      },
      "groups": {
        "items": {
          "$ref": "#/$defs/MvpGroupOut"
        },
        "title": "Groups",
        "type": "array"
      },
      "standalone_dtcs": {
        "items": {
          "type": "string"
        },
        "title": "Standalone Dtcs",
        "type": "array"
      },
      "issues": {
        "items": {
          "$ref": "#/$defs/MvpIssue"
        },
        "title": "Issues",
        "type": "array"
      },
      "meta": {
        "$ref": "#/$defs/RecallMetaOut",
        "title": "Meta"
      }
    },
    "required": [
      "groups",
      "standalone_dtcs",
      "issues",
      "status",
      "message",
      "uncertainty_note",
      "missing_required_info"
    ],
    "title": "DtcGroupingV1Output",
    "type": "object"
  }
}

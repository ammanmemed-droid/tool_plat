{
  "tool_name": "repair_planning_service",
  "tool_kind": "global_tool_service",
  "description": "按车辆与一个已选 DTC 组一次召回维修知识，返回组内全部候选维修指引；结果需要维修人员确认。",
  "input_schema": {
    "examples": [
      {
        "brand": "丰田",
        "dtc_codes": [
          "P0136",
          "P0137",
          "P0138"
        ],
        "language": "en",
        "model": "汉兰达",
        "year": 2021
      }
    ],
    "properties": {
      "brand": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Brand",
        "type": "string"
      },
      "model": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Model",
        "type": "string"
      },
      "year": {
        "anyOf": [
          {
            "maximum": 2100,
            "minimum": 1900,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Year"
      },
      "dtc_codes": {
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "minItems": 1,
        "title": "Dtc Codes",
        "type": "array"
      },
      "language": {
        "default": "en",
        "description": "Preferred display language as a BCP-47-style tag. Source knowledge is returned unchanged when no reviewed translation exists.",
        "maxLength": 35,
        "minLength": 2,
        "title": "Language",
        "type": "string"
      }
    },
    "required": [
      "brand",
      "model",
      "dtc_codes"
    ],
    "title": "RepairPlanningV1Input",
    "type": "object",
    "additionalProperties": false,
    "x-extract": {
      "brand": [
        "brand",
        "vehicle_info.brand",
        "messages[].content[].text.vehicle_info.brand"
      ],
      "model": [
        "vehicle_info.model",
        "messages[].content[].text.vehicle_info.model",
        "model"
      ],
      "year": [
        "year",
        "vehicle_info.year",
        "messages[].content[].text.vehicle_info.year"
      ],
      "dtc_codes": [
        "dtc_codes",
        "messages[].content[].dtc_codes",
        "system_dtc_groups[].dtc_codes[].dtc_code",
        "messages[].content[].text.system_dtc_groups[].dtc_codes[].dtc_code"
      ],
      "language": [
        "language"
      ]
    }
  },
  "output_schema": {
    "$defs": {
      "MvpGroupOut": {
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "group_name": {
            "title": "Group Name",
            "type": "string"
          },
          "representative_dtc": {
            "title": "Representative Dtc",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          },
          "dtc_category": {
            "anyOf": [
              {
                "enum": [
                  "动力系统",
                  "底盘系统",
                  "车身系统",
                  "网络通讯系统"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dtc Category"
          },
          "dtc_category_code": {
            "anyOf": [
              {
                "enum": [
                  "P",
                  "C",
                  "B",
                  "U"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dtc Category Code"
          },
          "semantic_family_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Semantic Family Code"
          },
          "system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "System"
          },
          "involved_parts": {
            "items": {
              "type": "string"
            },
            "title": "Involved Parts",
            "type": "array"
          },
          "shared_parts": {
            "items": {
              "type": "string"
            },
            "title": "Shared Parts",
            "type": "array"
          },
          "group_reason": {
            "enum": [
              "same_code",
              "same_system_shared_parts",
              "shared_parts",
              "semantic_family",
              "standalone"
            ],
            "title": "Group Reason",
            "type": "string"
          },
          "grouping_basis": {
            "items": {
              "type": "string"
            },
            "title": "Grouping Basis",
            "type": "array"
          },
          "match_level": {
            "enum": [
              "exact",
              "year_fallback"
            ],
            "title": "Match Level",
            "type": "string"
          },
          "year_fallback_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Year Fallback Dtcs",
            "type": "array"
          },
          "member_count": {
            "description": "Number of unique DTC codes",
            "minimum": 1,
            "title": "Member Count",
            "type": "integer"
          },
          "record_count": {
            "minimum": 1,
            "title": "Record Count",
            "type": "integer"
          },
          "priority": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Reserved until the product rule for group priority is confirmed.",
            "title": "Priority"
          }
        },
        "required": [
          "group_id",
          "group_name",
          "representative_dtc",
          "dtc_codes",
          "involved_parts",
          "shared_parts",
          "group_reason",
          "grouping_basis",
          "match_level",
          "year_fallback_dtcs",
          "member_count",
          "record_count"
        ],
        "title": "MvpGroupOut",
        "type": "object"
      },
      "MvpIssue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unmatched_dtcs",
              "multiple_groups_detected",
              "no_candidate_causes",
              "no_static_checks",
              "no_repair_guides",
              "probability_provider_failed",
              "external_reasons_truncated",
              "recall_truncated"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MvpIssue",
        "type": "object"
      },
      "RecallMetaOut": {
        "additionalProperties": false,
        "properties": {
          "brand": {
            "title": "Brand",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "requested_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Requested Dtcs",
            "type": "array"
          },
          "unmatched_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Unmatched Dtcs",
            "type": "array"
          },
          "uncertain_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Uncertain Dtcs",
            "type": "array"
          },
          "year_fallback_dtcs": {
            "items": {
              "type": "string"
            },
            "title": "Year Fallback Dtcs",
            "type": "array"
          },
          "query_truncated": {
            "title": "Query Truncated",
            "type": "boolean"
          },
          "recalled_record_count": {
            "minimum": 0,
            "title": "Recalled Record Count",
            "type": "integer"
          },
          "requested_language": {
            "title": "Requested Language",
            "type": "string"
          },
          "source_content_languages": {
            "items": {
              "type": "string"
            },
            "title": "Source Content Languages",
            "type": "array"
          },
          "language_fallback": {
            "title": "Language Fallback",
            "type": "boolean"
          },
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "grouping_policy_version": {
            "title": "Grouping Policy Version",
            "type": "string"
          }
        },
        "required": [
          "brand",
          "model",
          "year",
          "requested_dtcs",
          "unmatched_dtcs",
          "uncertain_dtcs",
          "year_fallback_dtcs",
          "query_truncated",
          "recalled_record_count",
          "requested_language",
          "source_content_languages",
          "language_fallback",
          "core_version",
          "grouping_policy_version"
        ],
        "title": "RecallMetaOut",
        "type": "object"
      },
      "RepairGuideOut": {
        "additionalProperties": false,
        "properties": {
          "guide_id": {
            "title": "Guide Id",
            "type": "string"
          },
          "local_cause_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Local Cause Name"
          },
          "dtc_codes": {
            "items": {
              "type": "string"
            },
            "title": "Dtc Codes",
            "type": "array"
          },
          "repair_steps": {
            "title": "Repair Steps",
            "type": "string"
          },
          "repair_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Repair Method"
          },
          "parts": {
            "items": {
              "type": "string"
            },
            "title": "Parts",
            "type": "array"
          },
          "required_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Required Tools"
          },
          "labor_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Labor Hours"
          },
          "reference_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reference Price"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "warning_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Warning Note"
          },
          "post_repair_verification": {
            "items": {
              "type": "string"
            },
            "title": "Post Repair Verification",
            "type": "array"
          },
          "requires_confirmation": {
            "default": true,
            "title": "Requires Confirmation",
            "type": "boolean"
          }
        },
        "required": [
          "guide_id",
          "dtc_codes",
          "repair_steps",
          "parts",
          "post_repair_verification"
        ],
        "title": "RepairGuideOut",
        "type": "object"
      }
    },
    "properties": {
      "uncertainty_note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Uncertainty Note"
      },
      "missing_required_info": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Missing Required Info"
      },
      "group": {
        "anyOf": [
          {
            "$ref": "#/$defs/MvpGroupOut"
          },
          {
            "type": "null"
          }
        ]
      },
      "repair_guides": {
        "items": {
          "$ref": "#/$defs/RepairGuideOut"
        },
        "title": "Repair Guides",
        "type": "array"
      },
      "issues": {
        "items": {
          "$ref": "#/$defs/MvpIssue"
        },
        "title": "Issues",
        "type": "array"
      },
      "meta": {
        "anyOf": [
          {
            "$ref": "#/$defs/RecallMetaOut"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "group",
      "repair_guides",
      "issues"
    ],
    "title": "RepairPlanningV1Output",
    "type": "object"
  }
}
